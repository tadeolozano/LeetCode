class Solution {
    public int maximumNumberOfStringPairs(String[] words) {
        int count = 0;

        for (int i = 0; i < words.length; i++) {
            String reversed = "" + words[i].charAt(1) + words[i].charAt(0);  // invertir la palabra, solo cambiar el orden de las dos letras

            for (int j = i + 1; j < words.length; j++) { //iterar sobre los demas elementos del arreglo
                if (reversed.equals(words[j])) {
                    count++;// si lo encuentra aumenta el contador
                    break;//salir del loop
                }
            }
        }

        return count;
    }
}
